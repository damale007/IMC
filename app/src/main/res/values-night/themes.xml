<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.IMCCalculadoraPesoIdeal" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="fondo" parent="Theme.IMCCalculadoraPesoIdeal">
        <item name="android:background">@color/black</item>
    </style>

    <style name="Texto">
        <item name="android:textColor">#EEE</item>
    </style>

    <style name="FondoRosa">
        <item name="android:background">#570404</item>
    </style>

    <style name="FondoVerde">
        <item name="android:background">#144704</item>
    </style>
</resources>