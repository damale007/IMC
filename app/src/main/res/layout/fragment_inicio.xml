<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    style="@style/fondo"
    tools:context=".ui.InicioFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:scaleType="fitXY"
                android:src="@drawable/primera_imagen" />

            <TextView
                android:id="@+id/idNombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/misDatos"
                android:textStyle="bold"
                android:textSize="35sp"
                style="@style/Texto"
                android:layout_marginTop="25dp"
                android:layout_marginHorizontal="20dp"/>

            <TextView
                android:id="@+id/idSexoEdad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Masculino, 50 años"
                android:textSize="18sp"
                style="@style/Texto"
                android:layout_marginHorizontal="20dp" />

            <TextView
                android:id="@+id/idAltura"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="182 cm de altura"
                android:textSize="18sp"
                style="@style/Texto"
                android:layout_marginStart="20dp" />

            <TextView
                android:id="@+id/idActividad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="182 cm de altura"
                android:textSize="18sp"
                style="@style/Texto"
                android:layout_marginStart="20dp" />

            <Button
                android:id="@+id/settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/editar"
                android:textColor="#FFF"
                android:layout_gravity="end"
                android:layout_marginEnd="20dp" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:paddingStart="20dp">

                <ImageView
                    android:id="@+id/imagenPeso"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/icono_peso"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/tituloPeso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/peso_dp"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    style="@style/Texto"
                    android:layout_marginStart="20dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/imagenPeso"/>

                <TextView
                    android:id="@+id/idPesoU"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="86"
                    android:layout_marginStart="20dp"
                    android:textSize="45sp"
                    android:textStyle="bold"
                    style="@style/Texto"
                    app:layout_constraintTop_toBottomOf="@id/tituloPeso"
                    app:layout_constraintStart_toEndOf="@id/imagenPeso"/>

                <TextView
                    android:id="@+id/idUnidadPeso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_marginBottom="5dp"
                    tools:text="Kgs."
                    android:textStyle="bold"
                    android:textSize="18sp"
                    style="@style/Texto"
                    app:layout_constraintBottom_toBottomOf="@id/idPesoU"
                    app:layout_constraintStart_toEndOf="@id/idPesoU"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FF0000"
                android:layout_marginHorizontal="20dp"
                app:cardCornerRadius="20dp" >

                <FrameLayout
                    android:id="@+id/idBarraContenedora"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:padding="0dp"
                    style="@style/FondoRosa">
                    <View
                        android:id="@+id/idBarraVerde"
                        android:layout_height="match_parent"
                        android:layout_width="20dp"
                        style="@style/FondoVerde"
                        android:layout_margin="0dp" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="vertical" >
                            <TextView
                                android:id="@+id/idIdeal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="20dp"
                                android:layout_marginTop="9dp"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                style="@style/Texto"
                                tools:text="Kgs." />

                            <TextView
                                android:id="@+id/idPesoResultado"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="20dp"
                                android:layout_marginTop="9dp"
                                tools:text="Kgs."
                                style="@style/Texto"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                app:layout_constraintTop_toBottomOf="@id/idIdeal"
                                app:layout_constraintStart_toEndOf="@id/imagenPeso"/>
                        </LinearLayout>
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/diferenciaIdeal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="10dp"
                android:textSize="18sp"
                tools:text="Ideal" />

            <com.google.android.gms.ads.AdView
                android:id="@+id/adView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginVertical="40dp"
                android:layout_gravity="center"
                ads:adSize="SMART_BANNER">
            </com.google.android.gms.ads.AdView>

                <TextView
                    android:id="@+id/idIMCIdeal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    style="@style/Texto"
                    tools:text="Kgs." />

                <TextView
                    android:id="@+id/idIMC"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="86"
                    android:layout_marginStart="20dp"
                    android:textSize="45sp"
                    style="@style/Texto"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/barraMedidora"
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        android:src="@drawable/barra_medidora"
                        android:scaleType="fitXY"
                        android:layout_margin="20dp" />

                    <ImageView
                        android:id="@+id/aguja"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:scaleType="fitXY"
                        android:layout_marginTop="65dp"
                        android:src="@drawable/aguja" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:textSize="18sp"
                android:textStyle="bold"
                android:text="@string/historial_de_pesos"
                style="@style/Texto"
                android:layout_marginTop="40dp"/>

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/chart"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="15dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="40dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/TMB"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    style="@style/Texto"
                    android:layout_marginStart="20dp" />

                <ImageView
                    android:id="@+id/questionTMB"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/question"
                    android:layout_marginStart="20dp" />
            </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/idTMB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="86"
                android:layout_marginStart="20dp"
                android:textSize="45sp"
                style="@style/Texto"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/calorias"
                android:textSize="18sp"
                style="@style/Texto"
                android:layout_marginStart="10dp" />
        </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="40dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/GEDT"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    style="@style/Texto"
                    android:layout_marginStart="20dp" />

                <ImageView
                    android:id="@+id/questionGEDT"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/question"
                    android:layout_marginStart="20dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/idGEDT"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="86"
                    android:layout_marginStart="20dp"
                    android:textSize="45sp"
                    style="@style/Texto"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/calorias"
                    android:textSize="18sp"
                    style="@style/Texto"
                    android:layout_marginStart="10dp" />
            </LinearLayout>

            <Button
                android:id="@+id/botonMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:textColor="@color/white"
                android:text="@string/botonMenu" />

            <View
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="105dp" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_marginBottom="87dp"
        android:layout_marginEnd="20dp"
        android:contentDescription="Añadir peso"
        app:tint="@color/black"
        android:layout_gravity="bottom|end"
        android:src="@drawable/ic_mas"
        app:fabSize = "normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>